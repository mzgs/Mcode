#include <winver.h>

#ifndef __GNUC__
#pragma code_page(65001)
#endif

/* Resource ID 1 is loaded automatically by Better-C-UI (cui_app_win32.c). */
1 ICON "@APP_RC_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VER_MAJOR@,@APP_VER_MINOR@,@APP_VER_PATCH@,@APP_VER_TWEAK@
 PRODUCTVERSION @APP_VER_MAJOR@,@APP_VER_MINOR@,@APP_VER_PATCH@,@APP_VER_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@APP_RC_AUTHOR@"
            VALUE "FileDescription", "@APP_RC_NAME@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@APP_RC_TARGET@"
            VALUE "LegalCopyright", "@APP_RC_COPYRIGHT@"
            VALUE "OriginalFilename", "@APP_RC_TARGET@.exe"
            VALUE "ProductName", "@APP_RC_NAME@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "@APP_RC_DESCRIPTION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
